# Queue Config 
REDIS_URL=redis://34.141.19.200:6379
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_ocr_jobs
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=900
QUEUE_RESULT_TTL=1200

# Service Config
WORKERS=2
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8004
ALLOWED_ORIGINS=https://34.107.43.152:80,http://34.107.43.152:80/,https://34.107.43.152:443,http://34.107.43.152:443/,https://api.zemrev.com,http://api.zemrev.com/,http://34.107.43.152,https://34.107.43.152
UPLOAD_DIR=/tmp/zemrev_ocr_uploads
QUEUE_MAX_WORKERS=1

# OCR-Specific Limits
MAX_FILE_SIZE=5242880
MAX_PAGES=40
TOOL_TIMEOUT=900