# ============================================================================
# FILE: services/ocr-service/.env.production
# PURPOSE: Production environment
# ============================================================================

# Queue Config (read by zemrev-queue package)
REDIS_URL=redis://34.141.19.200:6379
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_ocr_jobs
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=1800
QUEUE_RESULT_TTL=1200

# Service Config
WORKERS=2
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8004
ALLOWED_ORIGINS=https://www.zemrev.com,https://zemrev.com,https://api.zemrev.com,http://api.zemrev.com/
UPLOAD_DIR=/tmp/zemrev_ocr_uploads
QUEUE_MAX_WORKERS=2

# OCR-Specific Limits
MAX_FILE_SIZE=10485760
MAX_PAGES=40
TOOL_TIMEOUT=600