# ============================================================================
# FILE: services/ocr-service/.env
# PURPOSE: Development environment
# ============================================================================

# Queue Config 
REDIS_URL=redis://redis-ocr:6379
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
QUEUE_NAME=zemrev_ocr_jobs_dev
QUEUE_MAX_RETRIES=3
QUEUE_JOB_TIMEOUT=1800
QUEUE_RESULT_TTL=1200

# Service Config
WORKERS=1
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=8004
ALLOWED_ORIGINS=*
UPLOAD_DIR=/tmp/zemrev_ocr_uploads
QUEUE_MAX_WORKERS=1

# OCR-Specific Limits
MAX_FILE_SIZE=10485760
MAX_PAGES=40
TOOL_TIMEOUT=600